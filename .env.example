PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/dev-squad.sqlite
WORKSPACE_DIR=./workspaces
BACKUP_DIR=./backups
AI_PROVIDER=none
AI_MODEL=none
AI_API_KEY_ENV=DEV_SQUAD_AI_KEY
REQUEST_TIMEOUT_MS=30000
TOKEN_LIMIT=4096
LOG_LEVEL=info

# Checkpoint 2: no model is presumed free. Confirm account billing and model access first.
# API key values belong only in your local .env or operating-system environment.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_FREE_CONFIRMED=false
CEREBRAS_JSON_MODE=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FREE_CONFIRMED=false
GROQ_JSON_MODE=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FREE_CONFIRMED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FREE_CONFIRMED=false
OPENROUTER_JSON_MODE=false
HF_TOKEN=
HUGGINGFACE_MODEL=
HUGGINGFACE_FREE_CONFIRMED=false
HUGGINGFACE_JSON_MODE=false
AI_MAX_ATTEMPTS=3
AI_REQUEST_BUDGET=100
AI_TOKEN_RESERVATION_BUDGET=1000000
AI_LESSON_CHARS=2000

# Team orchestration: remains off until separately authorized. Each dispatch also needs authorizeRequest=true.
TEAM_LIVE_ENABLED=false

# Cerebras currently offers a payment-method-gated, expiring trial, not a renewing
# free tier. Its existing protocol adapter is retained but runtime access is blocked.
# Do not set CEREBRAS_FREE_CONFIRMED to bypass this policy.

# Optional prepaid DeepSeek preparation. Leave disabled; never selected by free routing.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PAID_ENABLED=false
DEEPSEEK_FREE_CONFIRMED=false
# Required before any future explicitly approved paid request: current worst-case
# USD rates per million tokens (including any applicable peak-time pricing), expiry,
# and positive request/daily/lifetime limits. Blank/unknown prices fail closed.
DEEPSEEK_INPUT_USD_PER_MILLION=
DEEPSEEK_OUTPUT_USD_PER_MILLION=
DEEPSEEK_PRICES_VERIFIED_UNTIL=
DEEPSEEK_REQUEST_LIMIT_USD=
DEEPSEEK_DAILY_LIMIT_USD=
DEEPSEEK_TOTAL_LIMIT_USD=

# New developer adapters stay off until read-only verification, account proof and
# a SEPARATE owner routing activation. Never paste keys into chat or commands.
# Keep the existing Gemini key/model; a 60s timeout is an optional local setting.
GEMINI_TIMEOUT_MS=60000
MISTRAL_API_KEY=
MISTRAL_MODEL=codestral-2508
MISTRAL_FREE_CONFIRMED=false
MISTRAL_JSON_MODE=true
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_FREE_CONFIRMED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct
CLOUDFLARE_FREE_CONFIRMED=false

# Big Three roles are per job; this does not enable paid requests.
TEAM_FOCUS=big_three
# Optional full paths to existing native CLIs. Their login tokens stay in CLI storage.
CODEX_EXECUTABLE=
CLAUDE_EXECUTABLE=

# Optional messenger pickup. Create a fine-grained token for DevSquadAI only, Contents: read-only.
GITHUB_HANDOFF_TOKEN=
# Set true only after personally checking that token permission in GitHub.
GITHUB_HANDOFF_READONLY_CONFIRMED=false
